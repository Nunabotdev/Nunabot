# --- Protocol economics ---
NUNA_FEE_BPS=80
NUNA_DEMAND_SLOPE=0.5
NUNA_CU_USD=0.012

# --- Reputation weights (must sum to 1.0) ---
NUNA_RW_UPTIME=0.25
NUNA_RW_SPEED=0.20
NUNA_RW_RELIABILITY=0.30
NUNA_RW_VOLUME=0.10
NUNA_RW_QUALITY=0.15
NUNA_ROUTING_REP_WEIGHT=0.7
NUNA_REP_EARN_BONUS=0.10
NUNA_SPEED_TARGET=1.0

# --- LLM (bot task planner) ---
NUNA_LLM_PROVIDER=anthropic
NUNA_LLM_API_KEY=
NUNA_LLM_MODEL=claude-haiku-4-5-20251001
NUNA_LLM_BASE_URL=https://api.anthropic.com/v1

# --- Solana / price oracle ---
NUNA_SOLANA_RPC=https://api.mainnet-beta.solana.com
NUNA_PRICE_API=https://api.coingecko.com/api/v3
NUNA_PRICE_TTL=30

# --- Server ---
NUNA_HOST=0.0.0.0
